---
const features = [
  { title: '礼物触发', text: '将指定礼物与本地互动效果连接起来，收到消息后即时响应。', icon: 'M20 12v9H4v-9M2 7h20v5H2zM12 7v14M12 7H7.5a2.5 2.5 0 1 1 2.4-3c.4 1.1 2.1 3 2.1 3Zm0 0h4.5a2.5 2.5 0 1 0-2.4-3c-.4 1.1-2.1 3-2.1 3Z' },
  { title: '视频播放', text: '为直播玩法准备视频内容，在需要的时候快速播放与重复播放。', icon: 'M3 5h18v14H3zM7 5v3m5-3v3m5-3v3M7 16v3m5-3v3m5-3v3m-3-7-4-2v4z' },
  { title: '弹幕互动', text: '实时查看聊天、礼物、点赞、关注等直播间消息。', icon: 'M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z M8 12h.01M12 12h.01M16 12h.01' },
  { title: '动作联动', text: '通过键盘、鼠标和系统控制，让互动效果自然进入直播流程。', icon: 'M13 2 4 14h6l-1 8 11-12h-6l-1-8Z' },
  { title: '自动化控制', text: '支持重连、录制、回放等辅助能力，减少直播中的重复操作。', icon: 'M20 7v5h-5M4 17v-5h5M5.6 9a7 7 0 0 1 11.6-2L20 12M4 12l2.8 5a7 7 0 0 0 11.6-2' },
  { title: '支持多平台直播间', text: '连接多个直播平台，统一采集直播间的弹幕、礼物等互动消息。', icon: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20ZM2 12h20M12 2a15 15 0 0 1 0 20M12 2a15 15 0 0 0 0 20' },
];
---
<div class="feature-grid">
  {features.map(feature => (
    <article class="feature-item">
      <h3>
        <svg class="feature-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
          <path d={feature.icon} />
        </svg>
        <span>{feature.title}</span>
      </h3>
      <p>{feature.text}</p>
    </article>
  ))}
</div>
